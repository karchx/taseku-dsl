cabal-version:       2.2

name:                kat
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/kat#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Author name here
maintainer:          example@example.com
copyright:           2026 Author name here
category:            Language
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md

executable kat
  hs-source-dirs:      src
  main-is:             Main.hs
  other-modules:       Lexer
                      ,AST
                      ,Parser
                      ,Codegen
                      ,Emit
                      ,JIT
  c-sources: cbits/cbits.c
  include-dirs: cbits
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5,
                       parsec,
                       haskeline,
                       mtl,
                       llvm-hs,
                       llvm-hs-pure,
                       containers,
                       bytestring
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints

source-repository head
  type:     git
  location: https://github.com/githubuser/kat
